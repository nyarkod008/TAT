# Copy this file to .env and fill in your Supabase project's values.
# These are safe to expose on-device — they're the public anon/publishable key,
# not a secret (the TomTom key stays server-side in Supabase Edge Function secrets,
# never here).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
